{
  "name": "chi-cto",
  "version": "0.1.0",
  "description": "Chi CTO - Autonomous Feature Orchestrator",
  "main": "src/index.ts",
  "scripts": {
    "test": "jest",
    "build": "tsc && esbuild src/mcp.ts --bundle --platform=node --format=esm --outfile=dist/mcp.js",
    "dev": "ts-node src/index.ts",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "cli": "npx ts-node src/cli-local.ts",
    "cli:suggest": "npx ts-node src/cli-local.ts suggest",
    "cli:mode-b": "npx ts-node src/cli-local.ts mode-b"
  },
  "keywords": [
    "priority-scoring",
    "task-management",
    "orchestration"
  ],
  "author": "Roderic Andrews",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.39",
    "esbuild": "^0.19.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wrangler": "^3.114.17"
  }
}
